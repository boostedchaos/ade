{
	"name": "@ade/cli",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"ade": "./src/index.ts"
	},
	"exports": {
		".": {
			"types": "./src/lib.ts",
			"default": "./src/lib.ts"
		}
	},
	"scripts": {
		"build": "bun build ./src/index.ts --target=node --format=esm --outfile ./dist/index.mjs",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"test": "bun test"
	},
	"dependencies": {
		"@superset/shared": "workspace:*"
	},
	"devDependencies": {
		"@superset/typescript": "workspace:*",
		"bun-types": "^1.3.1",
		"typescript": "^5.9.3"
	}
}
